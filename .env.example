# Kopiera den här filen till .env och ändra värdena:
#   cp .env.example .env

# Obligatoriskt i produktion – token som krävs för att logga in på /meny/admin.
# MÅSTE vara minst 32 tecken (valideras vid start), t.ex. generera med:
#   openssl rand -hex 32
ADMIN_TOKEN=byt-mot-nagot-langt-och-slumpat-minst-32-tecken

# Port som containern lyssnar på inuti (sällan behov att ändra)
PORT=3000

# Tidszon – påverkar vilket datum som räknas som "i dag"
TZ=Europe/Stockholm

# Värdport som webbgränssnittet exponeras på (om 3000 är upptagen)
# VARDPORT=3001

# Bas-sökväg: /meny (standard), t.ex. /mat, eller tom för att köra i roten
# BASE_PATH=/meny
